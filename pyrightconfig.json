{
  "include": [
    "backend/src",
    "backend/tests"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "backend/.venv",
    "frontend"
  ],
  "extraPaths": [
    "backend/src"
  ],
  "venvPath": "backend",
  "venv": ".venv",
  "pythonVersion": "3.12",
  "typeCheckingMode": "strict",
  "reportMissingTypeStubs": false
}
