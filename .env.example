# Keitaro Admin API Configuration
# Provide your Keitaro Admin API v1 base URL (either KEITARO_API_URL or KEITARO_BASE_URL is accepted)
KEITARO_API_URL=https://your-keitaro-tracker.example.com/admin_api/v1
KEITARO_BASE_URL=https://your-keitaro-tracker.example.com/admin_api/v1
KEITARO_API_KEY=replace-with-your-keitaro-api-key
KEITARO_TIMEOUT_SECONDS=15.0

# Sandbox Campaign Defaults
KEITARO_DEFAULT_DOMAIN_ID=1813
KEITARO_DEFAULT_GROUP_ID=10332
KEITARO_DEFAULT_TRAFFIC_SOURCE_ID=836
KEITARO_CAMPAIGN_PREFIX=test_bullo_

# Database Configuration (overridden to sqlite+aiosqlite:////app/data/adrobot.db in Docker Compose)
DATABASE_URL=sqlite+aiosqlite:///./adrobot.db
DB_ECHO=false

# Application & Runtime Configuration
APP_NAME=Adrobot API
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:8080","http://localhost:3000","http://localhost:5173"]
FRONTEND_PORT=8080
