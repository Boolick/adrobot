# Keitaro Admin API configuration
KEITARO_API_URL=https://your-keitaro-tracker.example.com
KEITARO_API_KEY=replace-with-your-keitaro-api-key
KEITARO_TIMEOUT_SECONDS=15.0

# Database configuration (async SQLAlchemy URL)
DATABASE_URL=sqlite+aiosqlite:///./adrobot.db
DB_ECHO=false

# Application configuration
APP_NAME=Adrobot API
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
